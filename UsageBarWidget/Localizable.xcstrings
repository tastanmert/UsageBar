  "strings": {
    "The 5-hour and weekly windows of your accounts.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplarının 5 saatlik ve haftalık pencereleri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの5時間枠と週間枠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 5시간 창과 주간 창."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账号的 5 小时和每周窗口。"
